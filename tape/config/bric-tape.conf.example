# /etc/bric/bric.conf on brictape / physical-library side
BRIC_ROLE=tape
BRIC_TAPE_HOME=/opt/bric2/tape
BRIC_TAPE_DB=/opt/bric2/tape/db/tape_catalog.db
BRIC_TAPE_SQL_INIT=/opt/bric2/tape/sql/tape_init.sql

# Durable logs. The tape daemon should normally write locally; the QNAP system area is fallback only.
BRIC_LOG_DIR=/var/log/bric
BRIC_LOG_FALLBACK_DIR=/mnt/data/bric/.system/log/brictape
BRIC_LOG_CAPTURE_STDIO=1
BRIC_LOG_GROUP=bric
BRIC_REQUIRE_LOGGING=1
BRIC_LOG_MAX_MESSAGE=4000
BRIC_QNAP=/mnt/data/bric
BRIC_QNAP_MNT=/mnt/data
BRIC_REQUIRE_NFS_BUS=1
BRIC_TAPE_BACKEND=real
BRIC_CHANGER=/dev/sg4
BRIC_DRIVE0=/dev/nst0
BRIC_DRIVE1=/dev/nst1
BRIC_TAPE_DRIVES=0 1
BRIC_PARALLEL_DRIVES=2
BRIC_TAPE_LOCK=/var/lock/bric_tape.lock
BRIC_TAPE_WORK_LOCK=/var/lock/bric_tape.lock.work
BRIC_CHANGER_LOCK=/run/bric/changer.lock
BRIC_DRIVE_LOCK_PREFIX=/run/bric/drive.lock.
BRIC_DRIVE_READY_TIMEOUT=900
BRIC_DRIVE_UNLOAD_TIMEOUT=900
# Optional per-drive overrides for asymmetric hardware (common values above remain defaults):
#BRIC_DRIVE_READY_TIMEOUT_0=900
#BRIC_DRIVE_READY_TIMEOUT_1=1800
#BRIC_DRIVE_UNLOAD_TIMEOUT_0=900
#BRIC_DRIVE_UNLOAD_TIMEOUT_1=1200
BRIC_DRIVE_COMMAND_TIMEOUT=600
BRIC_DRIVE_STATUS_TIMEOUT=30
BRIC_TAPE_IO_TIMEOUT=21600
# Optional per-drive stream timeout overrides for asymmetric drives:
#BRIC_TAPE_IO_TIMEOUT_0=21600
#BRIC_TAPE_IO_TIMEOUT_1=25200
BRIC_DRIVE_POLL_SECONDS=2
BRIC_UNLOAD_ON_COMPLETE=1
BRIC_TAPE_BLOCK=262144
BRIC_TAPE_STAGE_READ_BLOCK=4194304
BRIC_TAPE_VERIFY_POSITION_MODE=adaptive
BRIC_TAPE_BSFM_BYTES_PER_SEC=210000000
BRIC_TAPE_REWIND_MILLISECONDS=46000
BRIC_TAPE_FSF_MILLISECONDS_PER_FILE=400
BRIC_TAPE_CAPACITY_TB=18.0
BRIC_TAPE_HEADROOM_TB=0.30
BRIC_PRIMARY_PARITY=even
BRIC_CLAIM_TTL_HOURS=6
BRIC_POLL_SECONDS=10

BRIC_BUS_SIGN_KEY=/opt/bric2/keys/tape_bus_ecdsa_p256.pem
BRIC_BUS_VERIFY_KEY=/opt/bric2/keys/cluster_bus_ecdsa_p256.pub
BRIC_REQUIRE_SIGNING=1

# Root-only in-place release updater
BRIC_UPDATE_LINK=/usr/local/sbin/bric-update
# Root-only physical inventory importer (Review 30X+)
BRIC_TAPE_IMPORT_LINK=/usr/local/sbin/bric-tape-import-inventory
