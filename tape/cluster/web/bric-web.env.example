# Esempio di env di sito per l'interfaccia web BRIC. Copialo in bric-web.env (stessa cartella) e adatta.
# Viene caricato dal job SLURM (bric-web.sbatch). Se assente, valgono i default di lib_common.sh
# (BRIC_USER_KEY_FILE da $HOME/.bric/env.sh), già popolato da bric-setup-user.sh.

# Percorsi dei cataloghi / bus (devono combaciare con quelli usati in produzione dal cluster):
# export BRIC_HOME=/projects/bricsoftware/apps/bric2/cluster
# export BRIC_DB=$BRIC_HOME/db/cluster_catalog.db
# export BRIC_QNAP=/mnt/data/bric
# export BRIC_USER_KEY_FILE=$HOME/.bric/${USER}_user_key.txt  # generated by bric-setup-user.sh

# Chiavi di firma del bus (lato cluster): firma con la propria, verifica con la pubblica del tape.
# export BRIC_BUS_SIGN_KEY=/projects/bricsoftware/apps/bric2/keys/cluster_bus_ecdsa_p256.pem
# export BRIC_BUS_VERIFY_KEY=/projects/bricsoftware/apps/bric2/keys/tape_bus_ecdsa_p256.pub

# In produzione i backup vanno sottomessi come job SLURM:
# export BRIC_RUN_MODE=slurm

# Gateway per le istruzioni di tunnel mostrate all'utente:
# export BRIC_SSH_GATEWAY=supekgate.unicph.domain
